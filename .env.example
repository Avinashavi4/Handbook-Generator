# ─── LLM API (OpenAI-compatible) ─────────────────────────────
# PRIMARY: Grok 4.1 via xAI (assignment requirement)
# Sign up at https://console.x.ai ($25/mo free credits)
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-1

# ALTERNATIVE: OpenRouter (many models, OpenAI-compatible)
# XAI_API_KEY=your_openrouter_key
# XAI_BASE_URL=https://openrouter.ai/api/v1
# XAI_MODEL=deepseek/deepseek-chat-v3-0324

# ALTERNATIVE: Groq (free, fast inference)
# XAI_API_KEY=your_groq_key
# XAI_BASE_URL=https://api.groq.com/openai/v1
# XAI_MODEL=llama-3.3-70b-versatile

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ─── Optional Overrides ─────────────────────────────────────
LIGHTRAG_WORKING_DIR=./lightrag_data
EMBEDDING_MODEL=text-embedding-3-small
